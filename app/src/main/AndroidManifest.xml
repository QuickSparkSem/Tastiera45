<!-- Aggiungi fuori da <application>, vicino agli altri <uses-permission> -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

<queries>
    <package android:name="dev.notune.transcribe" />
    <package android:name="com.samsung.android.honeyboard" />
    <intent>
        <action android:name="android.speech.RecognitionService" />
    </intent>
    <intent>
        <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
    </intent>
</queries>

<!-- Aggiungi dentro <application> -->
<service
    android:name=".FloatingOrbService"
    android:exported="false" />
